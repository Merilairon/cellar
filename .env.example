DATABASE_PATH=./data/app.db
SESSION_SECRET=replace-with-at-least-32-random-characters
# BASE_URL must use the same port you open in the browser. If you set APP_PORT=3412
# for Docker, BASE_URL must be http://localhost:3412, or every POST is rejected (403)
# and the first-run /setup silently fails. Left unset, Docker Compose derives it from
# APP_PORT and the dev server assumes http://localhost:3000. Set it for any other host.
# BASE_URL=http://localhost:3000
# APP_PORT=3000
TRUSTED_PROXIES=

# URL import (optional)
# KEEP_RAW_HTML=false          # keep fetched/pasted HTML on disk (never auto-deleted)
# UPLOADS_DIR=./data/uploads   # default: <dir of DATABASE_PATH>/uploads
# RAW_HTML_DIR=./data/import-raw   # default: <dir of DATABASE_PATH>/import-raw
# RATE_LIMIT_IMPORT_MAX=20
# RATE_LIMIT_IMPORT_WINDOW_SEC=3600
# IMPORT_ALLOW_LOCAL_FETCH=false   # dev/test only; refused in production

# Docker / Caddy profile (see docs/deployment.md)
# SITE_ADDRESS=recipes.example.com
# BASE_URL=https://recipes.example.com
# TRUSTED_PROXIES=172.28.0.10

# Headless import (optional, v0.3.2). Leave empty to keep it off.
# Enable with: docker compose --profile headless up -d --build
# HEADLESS_URL=http://browser:3001
# HEADLESS_TOKEN=   # openssl rand -hex 32
